# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/stockmarket?schema=public"

# ─── Market data API keys ──────────────────────────────────
FINNHUB_API_KEY=""
TWELVEDATA_API_KEY=""

# ─── SEC EDGAR automated access ────────────────────────────
# Required before running SEC ingestion. Use a descriptive app/company name
# and a monitored contact address so SEC traffic is identifiable.
SEC_USER_AGENT="StockPulse Research contact@example.com"

# ─── Optional grounded AI ──────────────────────────────────
# AI is disabled unless BOTH a key and model are configured. By default the
# server uses Vercel AI Gateway's OpenAI-compatible endpoint. AI_BASE_URL can
# point to another trusted OpenAI-compatible endpoint instead.
AI_GATEWAY_API_KEY=""
AI_API_KEY=""
AI_MODEL=""
AI_BASE_URL="https://ai-gateway.vercel.sh/v1"

# ─── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Polling ───────────────────────────────────────────────
POLL_INTERVAL_MS="15000"
POLL_SYMBOLS="AAPL,MSFT,GOOGL,AMZN,TSLA,META,NVDA,JPM,V,JNJ"
