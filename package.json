{
  "name": "stockpulse",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "prebuild": "node ./scripts/prepare-hostinger-build.mjs",
    "build": "node ./scripts/run-next-build.mjs",
    "start": "node server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run typecheck:scripts && npm run lint && npm test",
    "audit:production": "node scripts/audit-production.mjs",
    "release:check": "node scripts/check-release.mjs",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "smoke:demo": "node scripts/smoke-demo.mjs",
    "browser:demo": "npm exec --yes --package=playwright@1.62.1 -- node scripts/browser-demo.mjs",
    "ingest:sec": "tsx scripts/ingest-sec.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.36.0",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "pg": "^8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tsx": "4.23.9",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "shadcn": "4.0.2",
    "tailwindcss": "^4",
    "typescript": "6.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
